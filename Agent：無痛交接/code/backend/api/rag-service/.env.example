OPENAI_API_KEY=sk-your-project-key
# 官方 API 使用預設值即可；相容代理服務請填入包含 /v1 的 base URL。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# Optional assistant-chat model gateway.
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_AUTH_TOKEN=your-openclaw-gateway-token
OPENCLAW_AGENT_ID=main
OPENCLAW_MODEL=openclaw
OPENCLAW_TIMEOUT_MS=30000

# Slack conversation records for colleague tone imitation.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
SLACK_SENIOR_USER_IDS=
SLACK_TONE_CHANNEL_IDS=
SLACK_TONE_USER_IDS=
SLACK_TONE_KEYWORDS=Project ORBIT,ORBIT,FM06
SLACK_SENIOR_DISPLAY_NAME=林書妍
SLACK_LOOKBACK_DAYS=60
SLACK_LIMIT=50
SLACK_INCLUDE_THREADS=true
SLACK_THREAD_REPLY_LIMIT=50
SLACK_MAX_PAGES=2

# Notion pages/databases used as handoff knowledge.
NOTION_API_KEY=
NOTION_PAGE_IDS=
NOTION_TONE_PAGE_IDS=
NOTION_DATABASE_ID=
NOTION_OWNER_NAME=林書妍
NOTION_TONE_AUTHOR_NAME=林書妍
NOTION_PROJECT_KEY=Project ORBIT
NOTION_FETCH_BLOCK_LIMIT=100
NOTION_FETCH_DEPTH=3
NOTION_DATABASE_PAGE_SIZE=20
NOTION_TONE_SECTION_NAMES=討論,語氣樣本,Slack 摘要,對話紀錄,目前結論,接手者第一天建議,主要風險與處理方式
NOTION_TONE_RECORD_LIMIT=8
NOTION_TONE_RECORD_MAX_CHARS=700
NOTION_VERSION=2022-06-28

# Set to mock when you want to force local demo records even if tokens exist.
WORKSPACE_CONNECTORS=live
CONNECTOR_TIMEOUT_MS=8000
CONNECTOR_TEXT_MAX_CHARS=1200
WORKSPACE_TONE_RECORD_LIMIT=16

# memory for local tests; deployed Sites defaults to D1 metadata/chunks + R2 original DOCX.
RAG_STORAGE_MODE=memory
# lexical: free deterministic baseline; embedding: vector only; hybrid: two-layer RRF.
RAG_RETRIEVAL_MODE=hybrid
# Current holdout winner is fixed 0.5/0.5 with k=10.
RAG_HYBRID_FUSION_MODE=fixed
RAG_EMBEDDING_API_KEY=your-embedding-provider-token
RAG_EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your-account-id/ai/v1
RAG_EMBEDDING_MODEL=@cf/baai/bge-m3
# Optional only for providers/models that support shortening output vectors.
# RAG_EMBEDDING_DIMENSIONS=1024

# Server-to-server bearer token for teammates/LLM services. Configure as a hosted secret.
RAG_SERVICE_API_KEY=replace-with-a-long-random-secret
# Use RAG_RETRIEVAL_URL only when overriding the full assistant query endpoint.
RAG_BASE_URL=http://localhost:3003
RAG_RETRIEVAL_URL=
RAG_RETRIEVAL_TOKEN=
RAG_PROJECT_ID=project-orbit
RAG_RETRIEVAL_TOP_K=8
# Set false when you want to verify guardrail refuses formal confidence without real RAG.
RAG_USE_DEMO_SOURCES=false

# Development/test only. The API can select only a relative scope below this trusted root.
KNOWLEDGE_LOCAL_ROOT=../data/無痛交接Demo資料_v2

# Production: comma-separated Sites-authenticated emails allowed to open /rag-admin.
RAG_ADMIN_EMAILS=admin@example.com
# Local development only; ignored when NODE_ENV=production.
RAG_ADMIN_DEV_EMAIL=local-admin@example.com
