OPENAI_API_KEY=sk-your-project-key
# 官方 API 使用預設值即可；相容代理服務請填入包含 /v1 的 base URL。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# memory for local tests; deployed Sites defaults to D1 metadata/chunks + R2 original DOCX.
RAG_STORAGE_MODE=memory
# lexical: free deterministic baseline; embedding: vector only; hybrid: two-layer RRF.
RAG_RETRIEVAL_MODE=hybrid
# Current holdout winner is fixed 0.5/0.5 with k=10.
RAG_HYBRID_FUSION_MODE=fixed
RAG_EMBEDDING_API_KEY=your-embedding-provider-token
RAG_EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your-account-id/ai/v1
RAG_EMBEDDING_MODEL=@cf/baai/bge-m3
# Optional only for providers/models that support shortening output vectors.
# RAG_EMBEDDING_DIMENSIONS=1024

# Server-to-server bearer token for teammates/LLM services. Configure as a hosted secret.
RAG_SERVICE_API_KEY=replace-with-a-long-random-secret

# Development/test only. The API can select only a relative scope below this trusted root.
KNOWLEDGE_LOCAL_ROOT=../data/無痛交接Demo資料_v2

# Production: comma-separated Sites-authenticated emails allowed to open /rag-admin.
RAG_ADMIN_EMAILS=admin@example.com
# Local development only; ignored when NODE_ENV=production.
RAG_ADMIN_DEV_EMAIL=local-admin@example.com
